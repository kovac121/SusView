# 复制为 .env 后填写。GitHub Actions 使用同名 Secrets。

# ===== AI（LongCat Anthropic 兼容接口）=====
LONGCAT_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=LongCat-Flash-Chat
AI_API_BASE=https://api.longcat.chat/anthropic

# 可选：直连 Anthropic 时使用
# ANTHROPIC_API_KEY=

# 可选：自定义 OpenAI 兼容接口
# CUSTOM_API_KEY=
# CUSTOM_API_BASE=
# CUSTOM_MODEL=

# ===== 邮件（163 SMTP）=====
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENTS=
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
